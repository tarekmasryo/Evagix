{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evagix.dev/schemas/policy-report.schema.json",
  "title": "Evagix Effective Policy Report",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "config_path",
    "profiles",
    "targets",
    "custom_targets",
    "fail_under",
    "fail_on_stale",
    "require_onboarding_pack",
    "parse_error",
    "ignored_findings",
    "severity_overrides",
    "custom_rule_count",
    "custom_forbidden_count",
    "custom_commands",
    "ignored_paths",
    "readme_ignore_claims"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "tool": { "const": "evagix" },
    "config_path": { "type": ["string", "null"] },
    "profiles": { "type": "array", "items": { "type": "string" } },
    "targets": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "custom_targets": { "type": "array", "items": { "type": "object" } },
    "fail_under": { "type": "integer", "minimum": 0, "maximum": 100 },
    "fail_on_stale": { "type": "boolean" },
    "require_onboarding_pack": { "type": "boolean" },
    "parse_error": { "type": "string" },
    "ignored_findings": { "type": "array", "items": { "type": "string" } },
    "severity_overrides": { "type": "object", "additionalProperties": { "type": "string" } },
    "custom_rule_count": { "type": "integer", "minimum": 0 },
    "custom_forbidden_count": { "type": "integer", "minimum": 0 },
    "custom_commands": { "type": "object", "additionalProperties": { "type": "string" } },
    "ignored_paths": { "type": "array", "items": { "type": "string" } },
    "readme_ignore_claims": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
